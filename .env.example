# Contact form delivery endpoint.
#
# Paste any form-backend URL that accepts a JSON POST and this site will use it
# immediately — no code changes. Tested shapes:
#
#   Formspree    https://formspree.io/f/xxxxxxxx
#   Web3Forms    https://api.web3forms.com/submit     (also set VITE_CONTACT_ACCESS_KEY)
#   Basin        https://usebasin.com/f/xxxxxxxx
#
# Leave this unset and the form will say so plainly and fall back to opening a
# prefilled email instead. It never silently discards a message.
VITE_CONTACT_ENDPOINT=

# Only needed for Web3Forms, which expects the key inside the payload.
VITE_CONTACT_ACCESS_KEY=
